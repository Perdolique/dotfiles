export LANG=en_US.UTF-8

export ZSH="$HOME/.oh-my-zsh"
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
zstyle ':omz:update' mode disabled
plugins=(git)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 -- "Oh My Zsh is not installed at $ZSH"
fi

# Keep PATH entries unique while loading optional developer tools.
typeset -gU path PATH

path_prepend() {
  local directory="$1"
  [[ -d "$directory" ]] || return 0
  path=("$directory" $path)
}

path_prepend "/usr/local/sbin"
path_prepend "$HOME/.local/bin"

if [[ -z "${PNPM_HOME:-}" ]]; then
  if [[ "$OSTYPE" == darwin* ]]; then
    export PNPM_HOME="$HOME/Library/pnpm"
  else
    export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
  fi
fi
path_prepend "$PNPM_HOME"

homebrew_prefix="${HOMEBREW_PREFIX:-}"
if [[ -z "$homebrew_prefix" ]] && (( $+commands[brew] )); then
  homebrew_prefix="$(brew --prefix 2>/dev/null)"
fi
if [[ -n "$homebrew_prefix" ]]; then
  path_prepend "$homebrew_prefix/opt/openjdk/bin"
  path_prepend "$homebrew_prefix/opt/mysql-client/bin"
fi
unset homebrew_prefix

unfunction path_prepend

zstyle ':completion:*:*:git*:*' ignored-patterns '*ORIG_HEAD'

alias python='python3'

# Initialize user-installed Perl modules only when local::lib is present.
if (( $+commands[perl] )) && [[ -d "$HOME/perl5/lib/perl5" ]]; then
  if perl_environment="$(perl -I"$HOME/perl5/lib/perl5" -Mlocal::lib="$HOME/perl5" 2>/dev/null)"; then
    eval "$perl_environment"
  fi
  unset perl_environment
fi

# Load Mole completion only when the command is available.
if (( $+commands[mole] )); then
  if mole_completion="$(mole completion zsh 2>/dev/null)"; then
    eval "$mole_completion"
  fi
  unset mole_completion
fi

git_branch_prompt() {
  git rev-parse --is-inside-work-tree &>/dev/null || return

  local branch default_branch color display_branch max_len prefix_len suffix_len

  max_len=16
  prefix_len=8
  suffix_len=5

  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
  default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  default_branch=${default_branch#origin/}
  [[ -z "$default_branch" ]] && default_branch="master"

  if [[ "$branch" == "$default_branch" ]]; then
    color="green"
  else
    color="yellow"
  fi

  display_branch="$branch"
  if (( ${#branch} > max_len )); then
    display_branch="${branch[1,prefix_len]}...${branch[-suffix_len,-1]}"
  fi

  print -r -- "%F{$color}($display_branch)%f "
}

setopt PROMPT_SUBST
PROMPT='%1~ $(git_branch_prompt)%# '

git-delete-merged() {
  command git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "Not inside a Git repository"
    return 1
  }

  command git fetch --prune origin || return 1

  local remote_head
  remote_head=$(command git symbolic-ref --quiet refs/remotes/origin/HEAD) || {
    echo "origin/HEAD is not configured. Run: git remote set-head origin --auto"
    return 1
  }

  local base=${remote_head#refs/remotes/}
  local default_branch=${base#origin/}
  local current_branch
  current_branch=$(command git branch --show-current)

  command git for-each-ref \
    --merged="$base" \
    --format='%(refname:short)' \
    refs/heads |
    while IFS= read -r branch; do
      [[ "$branch" == "$current_branch" ]] && continue
      [[ "$branch" == "$default_branch" ]] && continue

      if command git merge-base --is-ancestor "$branch" "$base"; then
        command git branch -D -- "$branch"
      fi
    done
}

local_zsh_config="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/local.zsh"
[[ -r "$local_zsh_config" ]] && source "$local_zsh_config"
unset local_zsh_config
